            ).pack(side="right")

    # ========================================================
    # EMERGENCY FLASHING INDICATOR
    # ========================================================

    def flash_indicator(self):

        if not self.running:
            return

        current = self.emergency_label.cget("fg")

        if current == "#ef4444":
            self.emergency_label.config(
                fg="#7f1d1d"
            )
        else:
            self.emergency_label.config(
                fg="#ef4444"
            )

        self.root.after(
            500,
            self.flash_indicator
        )

    # ========================================================
    # WEBSOCKET VIDEO CONNECTION
    # ========================================================

    def connect_video(self):

        if not websocket:
            self.update_video_status(
                "● VIDEO: websocket-client not installed",
                "#ef4444"
            )
            return

        try:

            self.update_video_status(
                "● VIDEO CONNECTION: CONNECTING",
                "#facc15"
            )

            self.ws = websocket.create_connection(
                "ws://localhost:8000/ws/video",
                timeout=5
            )

            self.update_video_status(
                "● VIDEO CONNECTION: CONNECTED",
                "#22c55e"
            )

            while self.running:

                data = self.ws.recv()

                if not data:
                    continue

                self.process_video_frame(data)

        except Exception as e:

            self.update_video_status(
                "● VIDEO CONNECTION: OFFLINE",
                "#ef4444"
            )

    # ========================================================
    # PROCESS VIDEO FRAME
    # ========================================================

    def process_video_frame(self, data):

        try:

            # JSON format:
            # {"frame": "base64..."}

            if isinstance(data, bytes):

                try:
                    data = data.decode("utf-8")
                except:
                    pass

            if isinstance(data, str):

                try:

                    obj = json.loads(data)

                    if "frame" in obj:
                        encoded = obj["frame"]
                    else:
                        encoded = data

                except json.JSONDecodeError:

                    encoded = data

            else:
                return

            image_data = base64.b64decode(encoded)

            if Image is None:
                return

            image = Image.open(
                io.BytesIO(image_data)
            )

            image.thumbnail(
                (850, 500)
            )

            photo = ImageTk.PhotoImage(image)

            self.root.after(
                0,
                self.display_frame,
                photo
            )

        except Exception:
            pass

    # ========================================================
    # DISPLAY FRAME
    # ========================================================

    def display_frame(self, photo):

        if not self.running:
            return

        self.video_photo = photo

        self.video_area.config(
            image=self.video_photo,
            text=""
        )

    # ========================================================
    # UPDATE STATUS
    # ========================================================

    def update_video_status(self, text, color):

        def update():

            if self.running:
                self.video_status.config(
                    text=text,
                    fg=color
                )

        self.root.after(
            0,
            update
        )

    # ========================================================
    # CLOSE APPLICATION
    # ========================================================

    def close(self):

        self.running = False

        try:
            if self.ws:
                self.ws.close()
        except:
            pass

        self.root.destroy()


# ============================================================
# APPLICATION START
# ============================================================

if __name__ == "__main__":

    root = tk.Tk()

    app = DoctorDashboard(root)

    root.protocol(
        "WM_DELETE_WINDOW",
        app.close
    )

    root.mainloop()
