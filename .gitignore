# =========================
# GHS Project .gitignore
# =========================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.pem
*.key
credentials.json

# Python / FastAPI Backend
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
pip-log.txt

# Node.js / Web Frontend
node_modules/
dist/
build/
.next/
npm-debug.log*

# Raspberry Pi / Hardware Logs
*.log
*.sqlite3

# OS Generated Files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.swp
