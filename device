#!/usr/bin/env python3
"""
main.py -- IoT Emergency Device Simulator ("Golden Hour System" field unit)
 
Simulates a field device (e.g. a laptop at an emergency scene) that:
 
  1. Streams webcam video to a hospital server over a WebSocket
     (ws://{HOSPITAL_IP}:8000/ws/video), and
  2. Runs a voice loop: listens on the microphone, sends transcribed
     speech to a chat/AI endpoint (http://{HOSPITAL_IP}:8000/api/chat),
     and speaks the server's text reply out loud.
 
The two loops run concurrently in separate threads and reconnect/retry
independently on failure, so a dropped Wi-Fi connection on one channel
doesn't take the other down.
 
--------------------------------------------------------------------
SETUP
--------------------------------------------------------------------
1. Set HOSPITAL_IP below to the server's LAN address.
 
2. Install dependencies (Python 3.9+):
 
     python -m pip install -r requirements.txt
     python -m pip install -r requirements-audio.txt  # optional microphone support
 
   Platform notes:
     - PyAudio (needed by SpeechRecognition for mic access):
         Windows : `python -m pip install pyaudio`, or if that fails,
                   `pip install pipwin && pipwin install pyaudio`
         macOS   : `brew install portaudio` first, then `pip install pyaudio`
         Linux   : `sudo apt-get install portaudio19-dev python3-pyaudio`
                   first, then `pip install pyaudio`
     - Python 3.13+: the stdlib `audioop` module (used internally by
       SpeechRecognition) was removed from the standard library. Also run:
         `pip install audioop-lts`
     - pyttsx3 uses the OS's TTS engine. On Linux it needs `espeak`
       (`sudo apt-get install espeak`). Windows/macOS need nothing extra.
     - macOS will prompt for Camera and Microphone permission for your
       terminal/Python the first time this runs -- grant both or the
       capture calls will silently fail.
     - recognize_google() below calls Google's free public speech-to-text
       API over the internet, so this laptop needs internet access for
       speech recognition even though video/chat go to a LAN server.
       It's rate-limited and not meant for heavy production use --
       swap in another SpeechRecognition backend if that's an issue.
 
3. Run:  python main.py   (stop with Ctrl+C)
 
--------------------------------------------------------------------
WIRE FORMAT (adjust to match your actual server)
--------------------------------------------------------------------
- Video frames are sent as JSON text messages over the WebSocket:
    {"type": "frame", "device_id": ..., "timestamp": ..., "encoding": "jpeg-base64", "data": "<base64 jpeg>"}
- Chat requests are POSTed as JSON: {"device_id": ..., "text": ..., "timestamp": ...}
- Chat replies are expected as JSON with the reply text in one of the
  keys "response" / "reply" / "text" -- change `send_to_chat_api()`
  below if your server uses a different field name or shape.
"""
 
from __future__ import annotations
 
import asyncio
import base64
import json
import logging
import signal
import threading
import time
 
try:
    import cv2
except ImportError:
    cv2 = None

try:
    import pyttsx3
except ImportError:
    pyttsx3 = None

try:
    import requests
except ImportError:
    requests = None

try:
    import speech_recognition as sr
except ImportError:
    sr = None

try:
    import websockets
except ImportError:
    websockets = None


def report_missing_dependencies() -> None:
    missing = []
    if cv2 is None:
        missing.append("opencv-python")
    if websockets is None:
        missing.append("websockets")
    if pyttsx3 is None:
        missing.append("pyttsx3")
    if requests is None:
        missing.append("requests")
    if sr is None:
        missing.append("SpeechRecognition")

    if missing:
        print(
            "Missing device dependencies: "
            + ", ".join(missing)
            + "\nInstall them with:\n"
            + "python -m pip install "
            + " ".join(missing)
        )
        raise SystemExit(1)


report_missing_dependencies()
 
# ======================================================================
# CONFIGURATION -- edit these for your setup
# ======================================================================
 
HOSPITAL_IP = "192.168.1.X"      # <-- set to Laptop 1's LAN IP
HOSPITAL_PORT = 8000
 
WS_URL = f"ws://{HOSPITAL_IP}:{HOSPITAL_PORT}/ws/video?role=device"
CHAT_URL = f"http://{HOSPITAL_IP}:{HOSPITAL_PORT}/api/chat"
 
DEVICE_ID = "field-unit-01"      # identifies this device to the server
 
CAMERA_INDEX = 0
TARGET_FPS = 15                  # video frames sent per second
JPEG_QUALITY = 55                # smaller frames reduce LAN latency
FRAME_WIDTH = 480
FRAME_HEIGHT = 360
 
RECONNECT_DELAY_SECONDS = 5      # wait before retrying a dropped connection
REQUEST_TIMEOUT_SECONDS = 15     # timeout for HTTP calls to the chat API
LISTEN_TIMEOUT_SECONDS = 5       # how long to wait for speech to start
PHRASE_TIME_LIMIT_SECONDS = 15   # max length of a single utterance
 
# ======================================================================
# LOGGING
# ======================================================================
 
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] [%(threadName)s] %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("golden_hour_device")
 
# Both worker threads watch this so Ctrl+C / SIGTERM stops everything cleanly.
shutdown_event = threading.Event()
 
 
# ======================================================================
# VIDEO STREAMING -- runs its own asyncio event loop inside a thread
# ======================================================================
 
def video_thread_main() -> None:
    """Entry point for the video-streaming thread."""
    try:
        asyncio.run(video_stream_loop())
    except Exception:
        log.exception("Video thread crashed")
 
 
async def video_stream_loop() -> None:
    if cv2 is None:
        log.error(
            "Video disabled: install opencv-python with "
            "'python -m pip install opencv-python'."
        )
        return
    if websockets is None:
        log.error(
            "Video disabled: install websockets with "
            "'python -m pip install websockets'."
        )
        return

    frame_interval = 1.0 / TARGET_FPS
    while not shutdown_event.is_set():
        cap = open_camera()
        if cap is None:
            log.error(
                "Could not open camera %s. Retrying in %ss.",
                CAMERA_INDEX,
                RECONNECT_DELAY_SECONDS,
            )
            await asyncio.sleep(RECONNECT_DELAY_SECONDS)
            continue

        try:
            try:
                log.info("Connecting to video stream at %s ...", WS_URL)
                async with websockets.connect(
                    WS_URL, ping_interval=20, ping_timeout=20, open_timeout=10
                ) as ws:
                    log.info("Video stream connected.")
                    await send_frames(cap, ws, frame_interval)
            except (OSError, websockets.exceptions.WebSocketException, asyncio.TimeoutError) as e:
                log.warning(
                    "Video connection lost/unavailable (%s). Retrying in %ss...",
                    e, RECONNECT_DELAY_SECONDS,
                )
            except Exception:
                log.exception(
                    "Unexpected error in video loop. Retrying in %ss...",
                    RECONNECT_DELAY_SECONDS,
                )
        finally:
            cap.release()
            log.info("Camera released.")

        if not shutdown_event.is_set():
            await asyncio.sleep(RECONNECT_DELAY_SECONDS)
 
 
def open_camera() -> cv2.VideoCapture | None:
    cap = cv2.VideoCapture(CAMERA_INDEX)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
    if not cap.isOpened():
        cap.release()
        return None
    return cap
 
 
async def send_frames(cap: cv2.VideoCapture, ws, frame_interval: float) -> None:
    """Read frames off the camera and push them over an already-open WebSocket."""
    encode_params = [int(cv2.IMWRITE_JPEG_QUALITY), JPEG_QUALITY]

    while not shutdown_event.is_set():
        start = time.monotonic()

        ok, frame = await asyncio.to_thread(cap.read)
        if not ok:
            log.warning("Failed to read a frame from the camera; retrying.")
            await asyncio.sleep(0.5)
            continue

        ok, buffer = await asyncio.to_thread(cv2.imencode, ".jpg", frame, encode_params)
        if not ok:
            log.warning("Failed to JPEG-encode a frame; skipping.")
            continue

        display_frame = frame.copy()
        cv2.putText(
            display_frame,
            "GHS EMERGENCY MODE ACTIVE",
            (20, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 0, 255),
            2,
            cv2.LINE_AA,
        )
        cv2.putText(
            display_frame,
            "Transmitting to Hospital...",
            (20, 60),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (0, 255, 255),
            2,
            cv2.LINE_AA,
        )
        cv2.imshow("GHS Emergency Display", display_frame)
        cv2.waitKey(1)

        payload = json.dumps({
            "type": "frame",
            "device_id": DEVICE_ID,
            "timestamp": time.time(),
            "encoding": "jpeg-base64",
            "data": base64.b64encode(buffer).decode("ascii"),
        })

        await ws.send(payload)

        elapsed = time.monotonic() - start
        await asyncio.sleep(max(0.0, frame_interval - elapsed))
 
 
# ======================================================================
# AUDIO / AI LOOP -- synchronous, runs in its own regular thread
# ======================================================================
 
def audio_thread_main() -> None:
    """Entry point for the speech-in / speech-out thread."""
    try:
        run_audio_loop()
    except Exception:
        log.exception("Audio thread crashed")
 
 
def run_audio_loop() -> None:
    if sr is None:
        log.error(
            "Audio disabled: install SpeechRecognition and its audio backend "
            "with 'python -m pip install SpeechRecognition PyAudio'."
        )
        return
    if requests is None:
        log.error(
            "Audio chat disabled: install requests with "
            "'python -m pip install requests'."
        )
        return

    recognizer = sr.Recognizer()
    tts_engine = init_tts_engine()
 
    try:
        microphone = sr.Microphone()
    except Exception:
        log.exception("Could not open a microphone -- audio loop disabled.")
        return
 
    try:
        with microphone as source:
            log.info("Calibrating for ambient noise...")
            recognizer.adjust_for_ambient_noise(source, duration=1)
    except OSError:
        log.exception("Microphone calibration failed -- audio loop disabled.")
        return
 
    log.info("Listening for speech...")
    while not shutdown_event.is_set():
        text = listen_for_speech(recognizer, microphone)
        if not text:
            continue
 
        log.info("Heard: %s", text)
        reply = send_to_chat_api(text)
        if reply:
            speak(tts_engine, reply)
 
 
def listen_for_speech(recognizer: sr.Recognizer, microphone: sr.Microphone) -> str | None:
    """Blocks until an utterance is captured and transcribed, or returns None."""
    try:
        with microphone as source:
            audio = recognizer.listen(
                source,
                timeout=LISTEN_TIMEOUT_SECONDS,
                phrase_time_limit=PHRASE_TIME_LIMIT_SECONDS,
            )
    except sr.WaitTimeoutError:
        return None  # nobody spoke during this window -- loop again
    except OSError:
        log.exception("Microphone I/O error; pausing before retrying.")
        time.sleep(RECONNECT_DELAY_SECONDS)
        return None
 
    try:
        return recognizer.recognize_google(audio)
    except sr.UnknownValueError:
        log.info("Heard audio but couldn't understand it.")
        return None
    except sr.RequestError as e:
        log.warning(
            "Speech recognition service unavailable (%s). Retrying in %ss...",
            e, RECONNECT_DELAY_SECONDS,
        )
        time.sleep(RECONNECT_DELAY_SECONDS)
        return None
 
 
def send_to_chat_api(text: str) -> str | None:
    """POSTs transcribed text to the hospital chat endpoint and returns its reply."""
    if requests is None:
        log.error("Chat request skipped because requests is not installed.")
        return None

    try:
        response = requests.post(
            CHAT_URL,
            json={"message": text},
            timeout=REQUEST_TIMEOUT_SECONDS,
        )
        response.raise_for_status()
    except requests.exceptions.RequestException:
        log.exception("Chat API request failed.")
        return None
 
    try:
        data = response.json()
    except ValueError:
        log.error("Chat API did not return valid JSON.")
        return None
 
    # Adjust this to match whatever field your server actually returns.
    reply = data.get("response") or data.get("reply") or data.get("text")
    if not reply:
        log.warning("Chat API response had no recognizable reply field: %s", data)
    return reply
 
 
def init_tts_engine():
    if pyttsx3 is None:
        log.warning(
            "Text-to-speech unavailable: install pyttsx3 with "
            "'python -m pip install pyttsx3'."
        )
        return None

    try:
        return pyttsx3.init()
    except Exception:
        log.exception("Could not initialize text-to-speech engine.")
        return None
 
 
def speak(engine, text: str) -> None:
    if engine is None:
        log.info("(TTS unavailable) Server said: %s", text)
        return
    try:
        engine.say(text)
        engine.runAndWait()
    except Exception:
        log.exception("Text-to-speech playback failed.")
 
 
# ======================================================================
# ENTRY POINT
# ======================================================================
 
def main() -> None:
    log.info("Starting Golden Hour field device (%s)", DEVICE_ID)
    log.info("Hospital server: %s:%s", HOSPITAL_IP, HOSPITAL_PORT)
    if not HOSPITAL_IP or HOSPITAL_IP.endswith(".X"):
        log.error(
            "Set HOSPITAL_IP to Laptop 1's LAN address before starting "
            "(current value: %r).",
            HOSPITAL_IP,
        )
        return
 
    threads = [
        threading.Thread(target=video_thread_main, name="VideoThread", daemon=True),
        threading.Thread(target=audio_thread_main, name="AudioThread", daemon=True),
    ]
    for t in threads:
        t.start()
 
    def handle_shutdown(signum, frame):
        log.info("Shutdown signal received, stopping...")
        shutdown_event.set()

    signal.signal(signal.SIGINT, handle_shutdown)
    signal.signal(signal.SIGTERM, handle_shutdown)

    try:
        while not shutdown_event.is_set():
            time.sleep(0.5)
    except KeyboardInterrupt:
        shutdown_event.set()

    try:
        cv2.destroyAllWindows()
    except Exception:
        pass

    log.info("Waiting for threads to exit...")
    for t in threads:
        t.join(timeout=5)
    log.info("Shutdown complete.")
 
 
if __name__ == "__main__":
    main()
 
