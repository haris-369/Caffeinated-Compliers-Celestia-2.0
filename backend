# --------------------------------------------------------------------------
# Entrypoint
# --------------------------------------------------------------------------


def _lan_ip() -> str:
    """Best-effort LAN address, so you know what URL to hand the IoT device."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("8.8.8.8", 80))  # no packets sent; just picks the route
        return sock.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        sock.close()


