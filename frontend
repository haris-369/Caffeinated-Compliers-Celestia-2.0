import tkinter as tk
from tkinter import ttk
import threading
import base64
import io
import json
import time

try:
    from PIL import Image, ImageTk
except ImportError:
    Image = None
    ImageTk = None

try:
    import websocket
except ImportError:
    websocket = None


# ============================================================
# GHS DOCTOR TELEMEDICINE DASHBOARD
# Pure Python / Tkinter
# ============================================================

class DoctorDashboard:

    def __init__(self, root):
        self.root = root
        self.root.title("GHS Doctor Dashboard")
        self.root.geometry("1400x850")
        self.root.configure(bg="#0f172a")

        self.running = True
        self.video_photo = None
        self.ws = None

        self.setup_styles()
        self.build_ui()

        # Start emergency indicator animation
        self.flash_indicator()

        # Start WebSocket connection
        if websocket:
            threading.Thread(
                target=self.connect_video,
                daemon=True
            ).start()

    # ========================================================
    # STYLING
    # ========================================================

    def setup_styles(self):
        style = ttk.Style()

        try:
            style.theme_use("clam")
        except:
            pass

        style.configure(
            "TFrame",
            background="#0f172a"
        )

        style.configure(
            "Card.TFrame",
            background="#1e293b"
        )

        style.configure(
            "TLabel",
            background="#0f172a",
            foreground="white",
            font=("Segoe UI", 11)
        )

        style.configure(
            "Card.TLabel",
            background="#1e293b",
            foreground="white",
            font=("Segoe UI", 11)
        )

    # ========================================================
    # MAIN UI
    # ========================================================

    def build_ui(self):

        # ----------------------------------------------------
        # HEADER
        # ----------------------------------------------------

        header = tk.Frame(
            self.root,
            bg="#111827",
            height=70
        )
        header.pack(fill="x")
        header.pack_propagate(False)

        title = tk.Label(
            header,
            text="GHS Doctor Dashboard",
            bg="#111827",
            fg="white",
            font=("Segoe UI", 24, "bold")
        )
        title.pack(side="left", padx=25)

        self.emergency_label = tk.Label(
            header,
            text="● EMERGENCY ACTIVE",
            bg="#111827",
            fg="#ef4444",
            font=("Segoe UI", 13, "bold")
        )
        self.emergency_label.pack(
            side="right",
            padx=30
        )

        # ----------------------------------------------------
        # MAIN CONTENT
        # ----------------------------------------------------

        main = tk.Frame(
            self.root,
            bg="#0f172a"
        )
        main.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=15
        )

        # LEFT SIDE
        left = tk.Frame(
            main,
            bg="#0f172a"
        )
        left.pack(
            side="left",
            fill="both",
            expand=True,
            padx=(0, 10)
        )

        # RIGHT SIDEBAR
        right = tk.Frame(
            main,
            bg="#0f172a",
            width=390
        )
        right.pack(
            side="right",
            fill="y"
        )
        right.pack_propagate(False)

        self.create_video_panel(left)
        self.create_chat_panel(left)

        self.create_location_panel(right)
        self.create_vitals_panel(right)
        self.create_case_panel(right)

    # ========================================================
    # VIDEO PANEL
    # ========================================================

    def create_video_panel(self, parent):

        container = tk.Frame(
            parent,
            bg="#1e293b",
            highlightbackground="#334155",
            highlightthickness=1
        )

        container.pack(
            fill="both",
            expand=True
        )

        title = tk.Label(
            container,
            text="LIVE PATIENT VIDEO",
            bg="#1e293b",
            fg="#38bdf8",
            font=("Segoe UI", 13, "bold")
        )
        title.pack(
            anchor="w",
            padx=15,
            pady=(12, 5)
        )

        self.video_area = tk.Label(
            container,
            text="Waiting for video feed...\n\nWebSocket:\nws://localhost:8000/ws/video",
            bg="#020617",
            fg="#64748b",
            font=("Segoe UI", 14),
            justify="center"
        )

        self.video_area.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=15
        )

        status = tk.Label(
            container,
            text="● VIDEO CONNECTION: CONNECTING",
            bg="#1e293b",
            fg="#facc15",
            font=("Segoe UI", 10, "bold")
        )

        status.pack(
            anchor="w",
            padx=15,
            pady=(0, 12)
        )

        self.video_status = status

    # ========================================================
    # AI CHAT PANEL
    # ========================================================

    def create_chat_panel(self, parent):

        container = tk.Frame(
            parent,
            bg="#1e293b",
            height=220
        )

        container.pack(
            fill="x",
            pady=(12, 0)
        )

        title = tk.Label(
            container,
            text="AI CHAT LOG",
            bg="#1e293b",
            fg="#a78bfa",
            font=("Segoe UI", 13, "bold")
        )
        title.pack(
            anchor="w",
            padx=15,
            pady=(12, 5)
        )

        chat = tk.Text(
            container,
            bg="#020617",
            fg="#e2e8f0",
            insertbackground="white",
            font=("Consolas", 10),
            height=8,
            wrap="word",
            relief="flat"
        )

        chat.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=(0, 15)
        )

        messages = [
            "[AI] Hello. Please tell me what happened.",
            "[PATIENT] I was involved in an accident.",
            "[AI] Are you experiencing pain?",
            "[PATIENT] Yes, I have pain in my chest.",
            "[AI] Stay calm. A doctor is connecting now.",
            "[AI] Emergency case forwarded to doctor."
        ]

        for message in messages:
            chat.insert("end", message + "\n\n")

        chat.config(state="disabled")

